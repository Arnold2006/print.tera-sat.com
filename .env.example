APP_URL=https://print.tera-sat.com
DB_HOST=localhost
DB_NAME=print_service

# REQUIRED — do not leave these empty or use 'root' with an empty password in production
DB_USER=db_username
DB_PASS=db_password

# REQUIRED — generate with: php -r "echo password_hash('your_password', PASSWORD_BCRYPT);"
# There is NO insecure default; the app will refuse to start if these are missing.
ADMIN_PASSWORD_HASH=$2y$10$examplehashhere
ADMIN_USERNAME=admin

# PayPal Smart Buttons – set PAYPAL_ENV to 'sandbox' for testing or 'live' for production
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# Print sizes and prices (in EUR)
PRINT_PRICE_30x40=14.75
PRINT_PRICE_50x70=24.10
PRINT_PRICE_60x80=40.25
